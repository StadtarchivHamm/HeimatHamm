  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ich bin eigentlich nur auf der Durchreise hier, aber wei\xDFt du was?
    Mein Anschlusszug f\xE4hrt erst sp\xE4ter, und das ist doch die perfekte Gelegenheit,
    herauszufinden, was es in Hamm au\xDFer dem Bahnhof noch so Spannendes gibt.
    Mal sehen, was wir in der Zeit alles entdecken k\xF6nnen. Kommst du mit?\r\n\r\nIch
    habe 11 Orte herausgesucht, die wir gemeinsam erkunden k\xF6nnen. Du kannst selbst
    entscheiden, zu welchem wir als N\xE4chstes gehen: Schau dir die Stationen einfach
    auf der Karte oder in der Liste an und w\xE4hle eine aus.\r\n\r\nSobald wir an
    der Station angekommen sind, erz\xE4hle ich dir, was ich dort herausgefunden
    habe. Au\xDFerdem ist an jedem Ort ein besonderes Objekt versteckt, das wir finden
    m\xFCssen. Das Objekt funktioniert wie ein Schl\xFCssel und \xF6ffnet eine T\xFCr
    in die Vergangenheit. Wenn die T\xFCr erscheint, kannst du hindurchgehen und
    noch mehr \xFCber den Ort erfahren. Du wirst dort echten Zeitzeug:innen begegnen
    und der Ort erbl\xFCht in einem ganz neuen Licht.\r\n\r\nNachdem du an einer
    Station alles entdeckt hast, erh\xE4ltst du einen Pflanzensamen. Diese solltest
    du gut aufbewahren, denn wenn du alle Orte besucht hast, erf\xE4hrst du den Standort
    einer geheimen zw\xF6lften Station. Und vielleicht brauchen wir dort genau diese
    Samen\u2026\r\n\r\nNa, bist du bereit?"
  m_isRightToLeft: 0
