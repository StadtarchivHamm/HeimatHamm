  m_Script: {fileID: 11500000, guid: 4bb0eb6211051ca48a0dc52987bf95be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  isActive: 1
  label: "An jeder Station ist ein Objekt versteckt, das einen besonderen Bezug zum
    Ort hat. Dein Tourguide sagt dir, wann du dich auf die Suche machen kannst. Sobald
    du das Objekt gefunden hast, wird es automatisch in deiner Sammlung abgelegt.
    Diese kannst du jederzeit \xFCber das Men\xFC oben links (das Symbol mit den
    drei Strichen) aufrufen. Dort kannst du dir alle gefundenen Objekte ansehen und
    mehr \xFCber sie erfahren."
  value: 
  hint: 
  role: 7
  allowsDirectInteraction: 0
  state: 0
