  m_Name: 
  m_EditorClassIdentifier: 
  isActive: 1
  label: "W\xE4hle aus, ob du den Rundgang in Leichter Sprache, mit einem der drei
    Avatare oder mit dem Audio Guide erleben m\xF6chtest."
  value: 
  hint: 
  role: 7
  allowsDirectInteraction: 0
