      m_Calls: []
  m_text: "At each stop you will first be welcomed by your avatar.\nThen you will
    have to collect a virtual object to start your time travel.\nAfter that, a virtual
    gate appears that you have to walk through.\_\nBehind the gate, a 3D scene awaits
    you. There you will meet a historical figure who will tell you the story of the
    place."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 852386df59f1c3a42aaa766ad0deb7ec, type: 2}
