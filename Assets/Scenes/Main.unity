--- !u!114 &771502942
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 771502940}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4bb0eb6211051ca48a0dc52987bf95be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  isActive: 1
  label: "Du findest alle Stationen entweder auf einer Karte oder in einer Listenansicht.
    Du kannst selbst entscheiden, in welcher Reihenfolge du die Orte besuchst.\r\nMit
    einem Klick auf \u201ENavigation starten\u201C wirst du direkt dorthin gef\xFChrt.
    Sobald du an einer Station angekommen bist, erh\xE4ltst du eine Push\u2011Benachrichtigung.
    Dort kannst du mit einem Klick auf \u201EWeiter\u201C in die erweiterte Realit\xE4t
    eintreten. Dein Tourguide erz\xE4hlt dir dann zun\xE4chst etwas \xFCber den Ort.\r\n\r\nFalls
    du die Navigationsfunktion nicht nutzen m\xF6chtest, findest du die Adresse jeder
    Station auch auf der Detailseite.\r\nUnd an jeder Station gibt es zus\xE4tzlich
    Marker am Boden, die du scannen kannst, um die erweiterte Realit\xE4t direkt
    zu starten."
  value: 
  hint: 
  role: 7
  allowsDirectInteraction: 0
  state: 0
